@article{Rousseeuw&Ruts1998,
 ISSN = {10170405, 19968507},
 URL = {http://www.jstor.org/stable/24306466},
 abstract = {The halfplane location depth of a point θ ∈ IR2 relative to a bivariate data set X = {x1,...,xn} is the minimal number of observations in any closed halfplane that contains θ (Tukey (1975)). The halfplane median or Tukey median is the θ with maximal depth k* (Denoho and Gasko (1992)). If this θ is not unique, the Tukey median is defined as the center of gravity of the set of points with depth k*. In this paper we construct two algorithms for computing the Tukey median. The first one is relatively straightforward but quite slow, whereas the second (called HALFMED) is much faster. A small simulation study is performed, and some examples are given.},
 author = {Peter J. Rousseeuw and Ida Ruts},
 journal = {Statistica Sinica},
 number = {3},
 pages = {827--839},
 publisher = {Institute of Statistical Science, Academia Sinica},
 title = {CONSTRUCTING THE BIVARIATE TUKEY MEDIAN},
 urldate = {2026-06-12},
 volume = {8},
 year = {1998}
}

